          {
            "content": "1\timport numpy as np\n2\timport pytest\n3\timport xarray as xr\n4\t\n5\tfrom xarray.core.common import get_squeeze_dims\n6\t\n7\t\n8\tclass TestSqueezeDimsCoveredLinesHardQA:\n9\t    def test_squeeze_dims_covered_lines_part_a(self) -> None:\n10\t        arr = xr.DataArray(np.zeros((1, 3, 1)), dims=(\"a\", \"b\", \"c\"))\n11\t\n12\t        with pytest.raises(ValueError):\n13\t            get_squeeze_dims(arr, dim=\"a\", axis=0)\n14\t\n15\t        auto_dims = get_squeeze_dims(arr)\n16\t        assert auto_dims == [\"a\", \"c\"]\n17\t\n18\t        dims_tuple = get_squeeze_dims(arr, dim=(\"a\", \"c\"))\n19\t        dims_scalar = get_squeeze_dims(arr, dim=\"a\")\n20\t        assert dims_tuple == [\"a\", \"c\"]\n21\t        assert dims_scalar == [\"a\"]\n22\t\n23\t        by_axis_single = get_squeeze_dims(arr, axis=0)\n24\t        by_axis_multi = get_squeeze_dims(arr, axis=[0, 2])\n25\t        assert by_axis_single == [\"a\"]\n26\t        assert by_axis_multi == [\"a\", \"c\"]\n27\t\n28\t        with pytest.raises(TypeError):\n29\t            get_squeeze_dims(arr, axis=[0, \"bad\"])\n30\t\n31\t        with pytest.raises(ValueError):\n32\t            get_squeeze_dims(arr, dim=\"b\")\n33\t\n34\t    def test_squeeze_dims_covered_lines_part_b(self) -> None:\n35\t        arr = xr.DataArray(np.zeros((1, 1, 2)), dims=(\"u\", \"v\", \"w\"))\n36\t\n37\t        got_auto = get_squeeze_dims(arr)\n38\t        got_dim = get_squeeze_dims(arr, dim=(\"u\", \"v\"))\n39\t        got_axis = get_squeeze_dims(arr, axis=[0, 1])\n40\t\n41\t        assert got_auto == [\"u\", \"v\"]\n42\t        assert got_dim == [\"u\", \"v\"]\n43\t        assert got_axis == [\"u\", \"v\"]\n44\t\n45\t\n46\t@pytest.mark.parametrize(\"_pad_case\", list(range(16)))\n47\tdef test_multitest_padding__cases(_pad_case):\n48\t    assert _pad_case >= 0\n49\t",

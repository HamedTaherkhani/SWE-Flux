            "content": "1\tfrom __future__ import annotations\n2\t\n3\timport numpy as np\n4\timport xarray as xr\n5\t\n6\t\n7\tclass TestCombineByCoordsMaxCallDepthHardQA:\n8\t    def test_combine_by_coords_max_call_depth_case(self) -> None:\n9\t        time_a = np.array([0, 1], dtype=np.int64)\n10\t        time_b = np.array([2, 3], dtype=np.int64)\n11\t        x_a = np.array([10, 20], dtype=np.int64)\n12\t        x_b = np.array([30, 40], dtype=np.int64)\n13\t\n14\t        ds_00 = xr.Dataset(\n15\t            {\"temp\": ((\"time\", \"x\"), np.array([[1.0, 2.0], [3.0, 4.0]], dtype=np.float64))},\n16\t            coords={\"time\": time_a, \"x\": x_a},\n17\t        )\n18\t        ds_01 = xr.Dataset(\n19\t            {\"temp\": ((\"time\", \"x\"), np.array([[5.0, 6.0], [7.0, 8.0]], dtype=np.float64))},\n20\t            coords={\"time\": time_a, \"x\": x_b},\n21\t        )\n22\t        ds_10 = xr.Dataset(\n23\t            {\"temp\": ((\"time\", \"x\"), np.array([[9.0, 10.0], [11.0, 12.0]], dtype=np.float64))},\n24\t            coords={\"time\": time_b, \"x\": x_a},\n25\t        )\n26\t        ds_11 = xr.Dataset(\n27\t            {\"temp\": ((\"time\", \"x\"), np.array([[13.0, 14.0], [15.0, 16.0]], dtype=np.float64))},\n28\t            coords={\"time\": time_b, \"x\": x_b},\n29\t        )\n30\t\n31\t        combined = xr.combine_by_coords(\n32\t            [ds_10, ds_01, ds_11, ds_00],\n33\t            fill_value=-999.0,\n34\t            combine_attrs=\"no_conflicts\",\n35\t        )\n36\t\n37\t        assert isinstance(combined, xr.Dataset)\n38\t        assert combined.sizes[\"time\"] == 4\n39\t        assert combined.sizes[\"x\"] == 4\n40\t        assert \"temp\" in combined.data_vars\n41\t",

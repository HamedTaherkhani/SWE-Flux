            "content": "1\timport json\n2\timport os\n3\t\n4\timport numpy as np\n5\t\n6\tfrom keras.src import testing\n7\tfrom keras.src.layers.regularization.dropout import Dropout\n8\t\n9\t\n10\tclass DropoutRepeatProfileBetaQATest(testing.TestCase):\n11\t    def test_repeated_output_profile(self):\n12\t        run_index = int(os.environ.get(\"QA_RUN_INDEX\", \"1\"))\n13\t        inputs = np.array(\n14\t            [\n15\t                [0.25, -0.75, 1.5, -2.0, 2.75, -3.25, 4.5, -5.0, 5.5, -6.25, 7.0, -7.75],\n16\t                [0.5, -1.25, 2.25, -2.5, 3.5, -4.75, 5.25, -6.0, 6.75, -7.5, 8.25, -9.0],\n17\t                [0.75, -1.5, 2.75, -3.0, 4.25, -5.5, 6.0, -6.75, 7.5, -8.25, 9.0, -9.75],\n18\t                [1.0, -1.75, 3.25, -3.5, 4.75, -6.0, 6.5, -7.25, 8.0, -8.75, 9.5, -10.25],\n19\t            ],\n20\t            dtype=\"float32\",\n21\t        )\n22\t        layer = Dropout(rate=0.35)\n23\t        output_tensor = np.array(layer(inputs, training=True))\n24\t        output_tensor = np.round(output_tensor, 6)\n25\t\n26\t        payload = {\n27\t            \"run_index\": run_index,\n28\t            \"output_tensor\": output_tensor.tolist(),\n29\t            \"output_sum\": float(np.round(np.sum(output_tensor), 6)),\n30\t        }\n31\t        print(\"QA_PAYLOAD:\" + json.dumps(payload, separators=(\",\", \":\")))\n32\t\n33\t        self.assertEqual(tuple(output_tensor.shape), (4, 12))\n34\t",

            "content": "90\t    try:\n91\t        return path.is_file()\n92\t    except Exception:\n93\t        return False\n94\t\n95\t\n96\tdef parse_file_input(  # pylint: disable=too-many-return-statements\n97\t    file_input: Union[FileInput, \"TelegramObject\"],\n98\t    tg_type: Optional[type[\"TelegramObject\"]] = None,\n99\t    filename: Optional[str] = None,\n100\t    attach: bool = False,\n101\t    local_mode: bool = False,\n102\t) -> Union[str, \"InputFile\", Any]:\n103\t    \"\"\"\n104\t    Parses input for sending files:\n105\t\n106\t    * For string input, if the input is an absolute path of a local file:\n107\t\n108\t        * if ``local_mode`` is ``True``, adds the ``file://`` prefix. If the input is a relative\n109\t        path of a local file, computes the absolute path and adds the ``file://`` prefix.\n110\t        * if ``local_mode`` is ``False``, loads the file as binary data and builds an\n111\t          :class:`InputFile` from that\n112\t\n113\t      Returns the input unchanged, otherwise.\n114\t    * :class:`pathlib.Path` objects are treated the same way as strings.\n115\t    * For IO and bytes input, returns an :class:`telegram.InputFile`.\n116\t    * If :attr:`tg_type` is specified and the input is of that type, returns the ``file_id``\n117\t      attribute.\n118\t\n119\t    Args:\n120\t        file_input (:obj:`str` | :obj:`bytes` | :term:`file object` | :class:`~telegram.InputFile`\\\n121\t            | Telegram media object): The input to parse.\n122\t        tg_type (:obj:`type`, optional): The Telegram media type the input can be. E.g.\n123\t            :class:`telegram.Animation`.\n124\t        filename (:obj:`str`, optional): The filename. Only relevant in case an\n125\t            :class:`telegram.InputFile` is returned.\n126\t        attach (:obj:`bool`, optional): Pass :obj:`True` if the parameter this file belongs to in\n127\t            the request to Telegram should point to the multipart data via an ``attach://`` URI.\n128\t            Defaults to `False`. Only relevant if an :class:`telegram.InputFile` is returned.\n129\t        local_mode (:obj:`bool`, optional): Pass :obj:`True` if the bot is running an api server\n130\t            in ``--local`` mode.\n131\t\n132\t    Returns:\n133\t        :obj:`str` | :class:`telegram.InputFile` | :obj:`object`: The parsed input or the untouched\n134\t        :attr:`file_input`, in case it's no valid file input.\n135\t    \"\"\"\n136\t    # Importing on file-level yields cyclic Import Errors\n137\t    from telegram import InputFile  # pylint: disable=import-outside-toplevel\n138\t\n139\t    if isinstance(file_input, str) and file_input.startswith(\"file://\"):\n140\t        if not local_mode:\n141\t            raise ValueError(\"Specified file input is a file URI, but local mode is not enabled.\")\n142\t        return file_input\n143\t    if isinstance(file_input, (str, Path)):\n144\t        if is_local_file(file_input):\n145\t            path = Path(file_input)\n146\t            if local_mode:\n147\t                return path.absolute().as_uri()\n148\t            return InputFile(path.open(mode=\"rb\"), filename=filename, attach=attach)\n149\t\n150\t        return file_input\n151\t    if isinstance(file_input, bytes):\n152\t        return InputFile(file_input, filename=filename, attach=attach)\n153\t    if hasattr(file_input, \"read\"):\n154\t        return InputFile(cast(IO, file_input), filename=filename, attach=attach)\n155\t    if tg_type and isinstance(file_input, tg_type):\n156\t        return file_input.file_id  # type: ignore[attr-defined]\n157\t    return file_input\n158\t",

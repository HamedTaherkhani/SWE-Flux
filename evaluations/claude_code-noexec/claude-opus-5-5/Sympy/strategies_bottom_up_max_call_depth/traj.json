            "content": "1\t\"\"\"Strategies to Traverse a Tree.\"\"\"\n2\tfrom sympy.strategies.util import basic_fns\n3\tfrom sympy.strategies.core import chain, do_one\n4\t\n5\t\n6\tdef top_down(rule, fns=basic_fns):\n7\t    \"\"\"Apply a rule down a tree running it on the top nodes first.\"\"\"\n8\t    return chain(rule, lambda expr: sall(top_down(rule, fns), fns)(expr))\n9\t\n10\t\n11\tdef bottom_up(rule, fns=basic_fns):\n12\t    \"\"\"Apply a rule down a tree running it on the bottom nodes first.\"\"\"\n13\t    return chain(lambda expr: sall(bottom_up(rule, fns), fns)(expr), rule)\n14\t\n15\t\n16\tdef top_down_once(rule, fns=basic_fns):\n17\t    \"\"\"Apply a rule down a tree - stop on success.\"\"\"\n18\t    return do_one(rule, lambda expr: sall(top_down(rule, fns), fns)(expr))\n19\t\n20\t\n21\tdef bottom_up_once(rule, fns=basic_fns):\n22\t    \"\"\"Apply a rule up a tree - stop on success.\"\"\"\n23\t    return do_one(lambda expr: sall(bottom_up(rule, fns), fns)(expr), rule)\n24\t\n25\t\n26\tdef sall(rule, fns=basic_fns):\n27\t    \"\"\"Strategic all - apply rule to args.\"\"\"\n28\t    op, new, children, leaf = map(fns.get, ('op', 'new', 'children', 'leaf'))\n29\t\n30\t    def all_rl(expr):\n31\t        if leaf(expr):\n32\t            return expr\n33\t        else:\n34\t            args = map(rule, children(expr))\n35\t            return new(op(expr), *args)\n36\t\n37\t    return all_rl\n38\t",

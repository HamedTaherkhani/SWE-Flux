    {
      "message": {
        "content": [
          {
            "content": "500\t    References\n501\t    ==========\n502\t\n503\t    .. [1] https://code.activestate.com/recipes/117225-convex-hull-and-diameter-of-2d-point-sets/\n504\t\n505\t    .. [2] Rotating Callipers Technique\n506\t        https://en.wikipedia.org/wiki/Rotating_calipers\n507\t\n508\t    \"\"\"\n509\t\n510\t    def rotatingCalipers(Points):\n511\t        U, L = convex_hull(*Points, **{\"polygon\": False})\n512\t\n513\t        if L is None:\n514\t            if isinstance(U, Point):\n515\t                raise ValueError('At least two distinct points must be given.')\n516\t            yield U.args\n517\t        else:\n518\t            i = 0\n519\t            j = len(L) - 1\n520\t            while i < len(U) - 1 or j > 0:\n521\t                yield U[i], L[j]\n522\t                # if all the way through one side of hull, advance the other side\n523\t                if i == len(U) - 1:\n524\t                    j -= 1\n525\t                elif j == 0:\n526\t                    i += 1\n527\t                # still points left on both lists, compare slopes of next hull edges\n528\t                # being careful to avoid divide-by-zero in slope calculation\n529\t                elif (U[i+1].y - U[i].y) * (L[j].x - L[j-1].x) > \\\n530\t                        (L[j].y - L[j-1].y) * (U[i+1].x - U[i].x):\n531\t                    i += 1\n532\t                else:\n533\t                    j -= 1\n534\t\n535\t    p = [Point2D(i) for i in set(args)]\n536\t\n537\t    if not all(i.is_Rational for j in p for i in j.args):\n538\t        def hypot(x, y):\n539\t            arg = x*x + y*y",

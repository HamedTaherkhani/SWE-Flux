            "content": "1\timport sys\n2\tfrom pathlib import Path\n3\t\n4\tMATPLOTLIB_SRC = Path(\"/testbed/lib\")\n5\tif str(MATPLOTLIB_SRC) not in sys.path:\n6\t    sys.path.insert(0, str(MATPLOTLIB_SRC))\n7\t\n8\timport numpy as np\n9\timport matplotlib.pyplot as plt\n10\t\n11\t\n12\tclass TestContourCntrGeneratorVerticesStateHardQA:\n13\t    def test_contour_cntr_generator_vertices_state_hard_case(self):\n14\t        np.random.seed(42)\n15\t        \n16\t        x = np.linspace(-3.0, 3.0, 25)\n17\t        y = np.linspace(-2.5, 2.5, 20)\n18\t        X, Y = np.meshgrid(x, y)\n19\t        \n20\t        Z = (np.sin(X) * np.cos(Y) + \n21\t             0.3 * np.sin(2*X) * np.cos(3*Y) + \n22\t             0.1 * X**2 - 0.05 * Y**2 +\n23\t             0.02 * np.random.randn(*X.shape))\n24\t        \n25\t        levels = np.linspace(Z.min(), Z.max(), 8)\n26\t        \n27\t        fig, ax = plt.subplots()\n28\t        contour_set = ax.contour(X, Y, Z, levels=levels)\n29\t\n30\t        # Matplotlib 3.8+: QuadContourSet subclasses Collection directly and has no\n31\t        # .collections list; paths live on the ContourSet itself.\n32\t        if hasattr(contour_set, \"collections\") and contour_set.collections:\n33\t            assert len(contour_set.collections) > 0\n34\t            for collection in contour_set.collections:\n35\t                paths = collection.get_paths()\n36\t                assert len(paths) >= 0\n37\t        else:\n38\t            paths = contour_set.get_paths()\n39\t            assert len(paths) > 0\n40\t\n41\t        cntr_obj = contour_set._contour_generator\n42\t        assert cntr_obj is not None\n43\t        \n44\t        test_level = float(levels[4])\n45\t        vertices_list, codes_list = cntr_obj.create_contour(test_level)\n46\t        \n47\t        assert isinstance(vertices_list, list)\n48\t        assert isinstance(codes_list, list)\n49\t        assert len(vertices_list) == len(codes_list)\n50\t        \n51\t        if len(vertices_list
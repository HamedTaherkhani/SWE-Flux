            "content": "1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tRotating-field streamplot: RK integration repeatedly samples the velocity grid via\n4\t`streamplot.interpgrid`, producing a large, deterministic call count.\n5\t\"\"\"\n6\timport importlib\n7\timport os\n8\timport sys\n9\tfrom pathlib import Path\n10\t\n11\t_testbed_root = Path(__file__).resolve().parent.parent.parent\n12\tsys.path.insert(0, str(_testbed_root / \"lib\"))\n13\tos.environ.setdefault(\"MPLBACKEND\", \"Agg\")\n14\t\n15\tnp = importlib.import_module(\"numpy\")\n16\tplt = importlib.import_module(\"matplotlib.pyplot\")\n17\t\n18\t\n19\tclass TestStreamplotRotatingInterpgridCallFrequencyQA:\n20\t    def test_streamplot_rotating_interpgrid_call_frequency_case(self):\n21\t        \"\"\"\n22\t        Uniform 10x10 grid on [-2, 2]^2, velocity (u, v) = (-y, x), density=0.8.\n23\t        Fixed parameters so `interpgrid` invocation count is stable across runs.\n24\t        \"\"\"\n25\t        x = np.linspace(-2.0, 2.0, 10)\n26\t        X, Y = np.meshgrid(x, x)\n27\t        U = -Y\n28\t        V = X\n29\t        fig, ax = plt.subplots()\n30\t        ax.streamplot(\n31\t            X,\n32\t            Y,\n33\t            U,\n34\t            V,\n35\t            density=0.8,\n36\t            broken_streamlines=True,\n37\t        )\n38\t        plt.close(fig)\n39\t",

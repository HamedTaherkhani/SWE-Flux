            "content": "1\tfrom __future__ import annotations\n2\t\n3\tfrom collections.abc import Callable\n4\tfrom typing import Any\n5\t\n6\timport reflex as rx\n7\tfrom reflex.components.tags.tag import render_prop\n8\t\n9\t\n10\tdef qa_callback() -> str:\n11\t    return \"callback-result\"\n12\t\n13\t\n14\tdef make_component() -> rx.Component:\n15\t    return rx.hstack(rx.text(\"component\"), rx.badge(\"rendered\"))\n16\t\n17\t\n18\tdef make_tuple() -> tuple[str, str]:\n19\t    return (\"tuple-left\", \"tuple-right\")\n20\t\n21\t\n22\tdef make_nested_tuple() -> tuple[str, tuple[str, str]]:\n23\t    return (\"outer\", (\"inner-left\", \"inner-right\"))\n24\t\n25\t\n26\tdef make_callable() -> Callable[[], str]:\n27\t    return qa_callback\n28\t\n29\t\n30\tdef make_literal() -> str:\n31\t    return \"literal-leaf\"\n32\t\n33\t\n34\tFACTORIES: dict[str, Callable[[], Any]] = {\n35\t    \"component\": make_component,\n36\t    \"tuple\": make_tuple,\n37\t    \"nested_tuple\": make_nested_tuple,\n38\t    \"callable\": make_callable,\n39\t    \"literal\": make_literal,\n40\t}\n41\t\n42\t\n43\tclass TestComponentsRenderPropPathFlakinessQA:\n44\t    def test_components_render_prop_path_flakiness_case(self):\n45\t        ordered_keys = set(FACTORIES)\n46\t        values = [FACTORIES[key]() for key in ordered_keys]\n47\t\n48\t        rendered = render_prop(values)\n49\t\n50\t        assert len(rendered) == len(FACTORIES)\n51\t        assert None in rendered\n52\t        assert any(isinstance(item, dict) and item.get(\"name\") == \"RadixThemesFlex\" for item in rendered)\n53\t        assert any(isinstance(item, list) and \"tuple-left\" in item for item in rendered)\n54\t",

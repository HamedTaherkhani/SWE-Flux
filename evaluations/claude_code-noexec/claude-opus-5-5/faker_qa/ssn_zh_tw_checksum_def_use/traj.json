            "content": "1\tfrom .. import Provider as SsnProvider\n2\t\n3\t\n4\tdef checksum(s: str) -> int:\n5\t    def _get_alphabet_weight(c: str) -> int:\n6\t        \"\"\"A=10, B=11, ...., H=17,\n7\t        I=34,\n8\t        J=18, K=19, ..., N=22,\n9\t        O=35,\n10\t        P=23, Q=24, ..., V=29,\n11\t        W=32,\n12\t        X=30, Y=31, Z=33\n13\t        \"\"\"\n14\t        if ord(c) < 73:  # A-H\n15\t            return ord(c) - 55\n16\t        if ord(c) == 73:  # I\n17\t            return ord(c) - 39\n18\t        if ord(c) < 79:  # J-N\n19\t            return ord(c) - 56\n20\t        if ord(c) == 79:  # O\n21\t            return ord(c) - 44\n22\t        if ord(c) < 87:  # P-V\n23\t            return ord(c) - 57\n24\t        if ord(c) == 87:  # W\n25\t            return ord(c) - 55\n26\t        if ord(c) < 90:  # X, Y\n27\t            return ord(c) - 58\n28\t        return ord(c) - 57  # Z\n29\t\n30\t    res = 0\n31\t    for i, c in enumerate(s):\n32\t        if i == 0:\n33\t            res = _get_alphabet_weight(c) % 10 * 9 + _get_alphabet_weight(c) // 10\n34\t        elif i < 9:\n35\t            res += int(c) * (9 - i)\n36\t        else:\n37\t            res += int(c)\n38\t    return res\n39\t\n40\t\n41\tclass Provider(SsnProvider):\n42\t    def ssn(self) -> str:\n43\t        ssn_without_last_char = self.numerify(self.random_uppercase_letter() + str(self.random_int(1, 2)) + \"#######\")\n44\t        last_char = str((10 - checksum(ssn_without_last_char) % 10) % 10)\n45\t        return ssn_without_last_char + last_char\n46\t",

            "content": "2445\t                    tot += _nP(_MultisetHistogram(n), k - 1)\n2446\t                    n[i] += 1\n2447\t                n[_N] += 1\n2448\t            return tot\n2449\t\n2450\t\n2451\t@cacheit\n2452\tdef _AOP_product(n):\n2453\t    \"\"\"for n = (m1, m2, .., mk) return the coefficients of the polynomial,\n2454\t    prod(sum(x**i for i in range(nj + 1)) for nj in n); i.e. the coefficients\n2455\t    of the product of AOPs (all-one polynomials) or order given in n.  The\n2456\t    resulting coefficient corresponding to x**r is the number of r-length\n2457\t    combinations of sum(n) elements with multiplicities given in n.\n2458\t    The coefficients are given as a default dictionary (so if a query is made\n2459\t    for a key that is not present, 0 will be returned).\n2460\t\n2461\t    Examples\n2462\t    ========\n2463\t\n2464\t    >>> from sympy.functions.combinatorial.numbers import _AOP_product\n2465\t    >>> from sympy.abc import x\n2466\t    >>> n = (2, 2, 3)  # e.g. aabbccc\n2467\t    >>> prod = ((x**2 + x + 1)*(x**2 + x + 1)*(x**3 + x**2 + x + 1)).expand()\n2468\t    >>> c = _AOP_product(n); dict(c)\n2469\t    {0: 1, 1: 3, 2: 6, 3: 8, 4: 8, 5: 6, 6: 3, 7: 1}\n2470\t    >>> [c[i] for i in range(8)] == [prod.coeff(x, i) for i in range(8)]\n2471\t    True\n2472\t\n2473\t    The generating poly used here is the same as that listed in\n2474\t    https://tinyurl.com/cep849r, but in a refactored form.\n2475\t\n2476\t    \"\"\"\n2477\t\n2478\t    n = list(n)\n2479\t    ord = sum(n)\n2480\t    need = (ord + 2)//2\n2481\t    rv = [1]*(n.pop() + 1)\n2482\t    rv.extend((0,) * (need - len(rv)))\n2483\t    rv = rv[:need]\n2484\t    while n:\n2485\t        ni = n.pop()\n2486\t        N = ni + 1\n2487\t        was = rv[:]\n2488\t        for i in range(1, min(N, len(rv))):\n2489\t            rv[i] += rv[i - 1]\n2490\t        for i in range(N, need):\n2491\t            rv[i] += rv[i - 1] - was[i - N]\n2492\t    rev = list(reversed(rv))\n2493\t  